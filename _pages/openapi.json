      "name": "Jigyasa Grover",
      "url": "https://jigyasa-grover.github.io/work-with-me/#contact",
      "email": "grover.jigyasa2@gmail.com"
    },
    "license": {
      "name": "CC BY 4.0 (Content & Metadata)",
      "url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "x-deprecation-policy": {
      "strategy": "URL path major versioning (/api/v1/)",
      "minimum_notice_days": 90,
      "documentation_url": "https://jigyasa-grover.github.io/docs/#versioning"
    }
  },
